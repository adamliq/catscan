    ]
  },
  "log_id_format": {
    "description": "log_id is a 10-digit number combining type, subtype (category), and message ID.",
    "structure": "digits 1-2 = log type, digits 3-4 = subtype/category number, digits 5-10 = message ID (leading zero of message ID is dropped when displayed)",
    "example": "0001010018 -> type=01 (event), category=01 (system), message_id=010018 (displayed as 10018)"
  },
