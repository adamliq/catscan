  "common_field_schema": {
    "description": "Common envelope fields present on FortiManager event log messages, in addition to message-specific fields defined per individual log_id.",
    "example_raw_message": "2020-05-12 17:01:16 log_id=0001010018 type=event subtype=system pri=information desc=\"User login/logout successful\" user=\"admin\" userfrom=\"JSON(10.100.55.254)\" msg=\"user 'admin' with profile 'Super_User' logout from JSON(10.100.55.254)\" session_id=5108 adminprof=\"Super_User\"",
    "fields": [
      { "name": "date",       "example": "2020-05-12", "type": "string (YY-MM-DD)", "description": "Date the event occurred" },
      { "name": "time",       "example": "17:01:16", "type": "string (HH:MM:SS)", "description": "Time the event occurred" },
      { "name": "log_id",     "example": "0001010018", "type": "string (10-digit)", "description": "Composite ID: type (digits 1-2) + subtype/category (digits 3-4) + message ID (digits 5-10)" },
      { "name": "type",       "example": "event", "type": "string", "description": "Log type" },
      { "name": "subtype",    "example": "system", "type": "string", "description": "Log subtype code (see log_types.subtypes)" },
      { "name": "pri",        "example": "information", "type": "string", "description": "Priority/severity level" },
      { "name": "desc",       "example": "User login/logout successful", "type": "string", "description": "Static description of the event class" },
      { "name": "user",       "example": "admin", "type": "string", "description": "User who triggered the event" },
      { "name": "userfrom",   "example": "JSON(10.100.55.254)", "type": "string", "description": "Source of the action (interface/method + IP)" },
      { "name": "msg",        "example": "user 'admin' with profile 'Super_User' logout from JSON(10.100.55.254)", "type": "string", "description": "Full human-readable message" },
      { "name": "session_id", "example": "5108", "type": "integer", "description": "Session identification number" },
      { "name": "adminprof",  "example": "Super_User", "type": "string", "description": "Administrator profile associated with the account" }
    ],
    "note": "Each individual message ID (e.g. 0001010018) can carry additional message-specific fields beyond this common set, documented per message under each subtype in the official Log Message Reference. Not enumerated here due to volume (hundreds of message IDs across all subtypes)."
  }
}
