    "action_codes": {
      "A": "Automatically open a ticket in your organization's support team",
      "AE": "Automatically open a support ticket and escalate the ticket",
      "E": "Send email to the appropriate team within your organization"
    },
    "alarms_and_events": {
      "severity_levels": [
        {
          "severity": "Critical",
          "color": "red",
          "description": "Serious events that impair or shut down the operation of a network function"
        },
        {
          "severity": "Major",
          "color": "yellow",
          "description": "Serious events that affect, but do not shut down, the operation of a network function"
        },
        {
          "severity": "Medium",
          "color": "orange / blue (version dependent)",
          "description": "Events that might impair the performance of a network function"
        },
        {
          "severity": "Minor",
          "color": "blue / green (version dependent)",
          "description": "Events that might diminish the performance of a network function"
        }
      ],
      "common_alarm_event_fields": [
        {
          "field": "entry_time",
          "type": "integer (epoch ms) or timestamp",
          "description": "Time the event/alarm was logged (UTC)"
        },
        {
          "field": "eventname / Name / rulename",
          "type": "string",
          "description": "Name of the event or alarm rule"
        },
        {
          "field": "severity / severity_level",
          "type": "enum",
          "values": ["Critical", "Major", "Medium", "Minor"],
          "description": "Severity"
        },
        {
          "field": "host_name / vdevice-host-name",
          "type": "string",
          "description": "Device hostname"
        },
        {
          "field": "system_ip",
          "type": "IP address",
          "description": "Device system IP"
        },
        {
          "field": "component",
          "type": "string",
          "description": "Component that generated the event"
        },
        {
          "field": "message / details",
          "type": "string",
          "description": "Human-readable description"
        },
        {
          "field": "site_id / object",
          "type": "integer / string",
          "description": "Site or device grouping"
        },
        {
          "field": "active / acknowledged / suppressed",
          "type": "boolean",
          "description": "Alarm state flags"
        },
        {
          "field": "uuid / id",
          "type": "string (UUID)",
          "description": "Unique identifier"
        },
        {
          "field": "possible_causes",
          "type": "array of strings",
          "description": "Possible causes"
        },
        {
          "field": "devices",
          "type": "array of objects",
          "description": "Affected devices (system-ip, etc.)"
        },
        {
          "field": "cleared_time / cleared_by / cleared_events",
          "type": "timestamp / UUID / array",
          "description": "Clearing information"
        }
      ],
      "common_alarm_types_examples": [
        "BFD_Node_Up / BFD_Node_Down",
        "BFD_TLOC_Up / BFD_TLOC_Down",
        "BFD_Site_Up / BFD_Site_Down",
        "Control_Vsmart_Up / Control_Vsmart_Down",
        "Control_Vmanage_Up / Control_Vmanage_Down",
        "Control_TLOC_Up / Control_TLOC_Down",
        "Control_Site_Up / Control_Site_Down",
        "Control_Node_Up / Control_Node_Down",
        "Control_All_Vsmarts_Down",
        "OMP_Site_Up / OMP_Site_Down",
        "OMP_Node_Up / OMP_Node_Down",
        "OMP_Vsmart_Up / OMP_Vsmart_Down",
        "OMP_All_Vsmarts_Down",
        "BGP_Router_Up / BGP_Router_Down",
        "OSPF_Router_Up / OSPF_Router_Down",
        "Tracker_State_Change",
        "Nat_Update",
        "Device Activation Failed",
        "AAA Admin Password Change",
        "AAA Password Expired",
        "vManage Critical Space Usage",
        "vManage Node Reachability State",
        "vManage Service State",
        "Disaster Recovery related (Primary/Secondary/Arbitrator Down, Switchover, etc.)"
      ],
      "note": "When a site goes down, Manager typically raises Site down, Node down, and TLOC down alarms (with suppression of redundant lower-level alarms in newer releases)."
    },
    "audit_logs": {
      "description": "Cisco SD-WAN Manager audit logs (stored in vmanage-syslog.log and accessible via API/UI)",
      "common_fields": [
        {
          "field": "logid",
          "type": "string (UUID)",
          "description": "Unique log identifier"
        },
        {
          "field": "entry_time",
          "type": "timestamp",
          "description": "Time of the audit entry"
        },
        {
          "field": "logmodule",
          "type": "string",
          "description": "Module (e.g. maintenance, upgrade)"
        },
        {
          "field": "logfeature",
          "type": "string",
          "description": "Feature related to the log"
        },
        {
          "field": "loguser",
          "type": "string",
          "description": "User who performed the action"
        },
        {
          "field": "logusersrcip",
          "type": "IP address",
          "description": "Source IP of the user"
        },
        {
          "field": "logmessage",
          "type": "string",
          "description": "Main log message"
        },
        {
          "field": "logdeviceid",
          "type": "string",
          "description": "Device identifier related to the action"
        },
        {
          "field": "auditdetails",
          "type": "array of strings",
          "description": "Detailed step-by-step audit information"
        }
      ]
    },
    "vmanage_application_log_format": {
      "format": "Date - Log Level - Restful API Tracing ID - Host Name - Class - Thread - Tenant ID [Optional] - message",
      "example": "04-Apr-2023 10:22:27,969 CST INFO [af7c0465-1fca-4e6d-8d39-6c03b1357b4b] [vmanage_scale1] [VmanageSyslogLogger] (default task-3459) |default| deviceAction: Request for action"
    },
    "binary_trace": {
      "description": "Binary trace support for selected daemons (from IOS XE 17.4.1a / Control Components 20.x+)",
      "supported_daemons": ["fpmd", "ftm", "ompd", "vdaemon", "cfgmgr"],
      "trace_levels": ["debug", "emergency", "error", "info", "noise", "notice", "verbose", "warning"],
      "note": "Used for deeper troubleshooting of SD-WAN daemons; can impact performance if set too high."
    },
    "remote_logging": {
      "protocols": ["UDP", "TCP", "TLS (RFC 5425)"],
      "notes": [
        "TLS provides mutual authentication and encryption",
        "Debug messages generally cannot be forwarded to remote hosts",
        "Configurable via system logging templates / configuration groups / CLI",
        "Source interface and facility can be specified"
      ]
    },
    "notes": [
      "Devices generate events/notifications → SD-WAN Manager correlates them into Alarms.",
      "Devices can also emit SNMP traps (each trap has a corresponding notification).",
      "All task, activity, administration, and device logs in Manager are displayed in UTC.",
      "Manager suppresses or does not clear alerts that resolve within ~30 seconds to reduce noise.",
      "Exact message sets, alarm names, and available fields vary by software release (20.x vs 26.x) and platform (vEdge, IOS XE Catalyst SD-WAN, Controllers).",
      "Full exhaustive per-message tables are published in the official Cisco Catalyst SD-WAN Network Monitoring Guide – Syslog Messages chapter and the Cisco IOS XE Catalyst SD-WAN Alarms Guide / Alarm Reference Guide."
    ],
    "primary_sources": [
      "Cisco Catalyst SD-WAN Control Components and Device Management Guide – System Logging",
      "Cisco Catalyst SD-WAN Network Monitoring Guide – Alarms, Events, and Logs",
      "Cisco Catalyst SD-WAN Network Monitoring Guide – Syslog Messages",
      "Cisco IOS XE Catalyst SD-WAN Alarms Guide / Alarm Reference Guide",
      "Cisco SD-WAN Manager API (Alarm, EventsBySeverity, Audit Log fields)"
    ]
  }
}
