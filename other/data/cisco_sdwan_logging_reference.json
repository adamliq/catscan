{
  "cisco_catalyst_sdwan_logging_comprehensive": {
    "product": "Cisco Catalyst SD-WAN (formerly Viptela / Cisco SD-WAN)",
    "description": "Comprehensive reference for log types, local files, syslog formats, severity levels, software modules/daemons, individual syslog messages, alarms, events, audit logs, and field schemas.",
    "local_log_files": [
      {
        "file": "auth.log",
        "path": "/var/log/auth.log",
        "description": "Login, logout, and superuser access events, and usage of authorization systems"
      },
      {
        "file": "kern.log",
        "path": "/var/log/kern.log",
        "description": "Kernel messages"
      },
      {
        "file": "messages.log",
        "path": "/var/log/messages.log",
        "description": "Consolidated log file that contains syslog messages from all sources"
      },
      {
        "file": "vconfd.log",
        "path": "/var/log/vconfd.log",
        "description": "All configuration-related syslog messages"
      },
      {
        "file": "vdebug.log",
        "path": "/var/log/vdebug.log",
        "description": "All debug messages for modules whose debugging is turned on, plus syslog messages above the configured priority value. Supports module-specific logging levels (e.g. sysmgr: on/off; chmgr: off/low/normal/high). Debug messages cannot be sent to remote hosts."
      },
      {
        "file": "vsyslog.log",
        "path": "/var/log/vsyslog.log",
        "description": "All syslog messages from Cisco Catalyst SD-WAN processes (daemons) above the configured priority value. Default priority is informational (severity 6)."
      },
      {
        "file": "vmanage-syslog.log",
        "path": "/var/log/vmanage-syslog.log",
        "description": "Cisco SD-WAN Manager (vManage) audit log messages"
      }
    ],
    "unused_standard_linux_files": [
      "cron.log",
      "debug.log",
      "lpr.log",
      "mail.log",
      "syslog"
    ],
    "syslog_formats": {
      "classic_pre_20_15": {
        "format": "%<FACILITY>-<host>-<MNEMONIC>-<SEVERITY>-<SEVERITY-name>-<SEVERITY>-<MessageId>: <MESSAGE TEXT>",
        "example": "*Dec 11 09:36:27.358: %Cisco-SDWAN-NR-C8200-1N-4T-FTMD-5-NTCE-1000026: **HSL-LOGGING IMPLICIT-ACL** : VPN-0 Src: 192.168.104.16/0 Dst: 192.168.104.20/0 Proto: 1 TOS: 0 LogReason: SDWAN_SERV_ICMP_EXCEPT_TS Count: 1Bytes: 114"
      },
      "newer_from_20_15": {
        "format": "%<FACILITY>-<SEVERITY>-<MNEMONIC>: <MESSAGE TEXT>",
        "example": "Dec 20 18:47:33.237: %SDWAN-5-FTMD : **HSL-LOGGING IMPLICIT-ACL** : VPN-0 Src: 10.1.17.14/12346 Dst: 192.168.60.100/12346 Proto: 17 TOS: 192 LogReason: SDWAN_SERV_UDP Count: 1Bytes: 171 Ingress-Interface: GigabitEthernet2 Egress-Interface: GigabitEthernet2"
      },
      "alternative_formats": [
        "facility.source date - source - module - level - MessageID: text-of-syslog-message",
        "sequence-number:timestamp: %facility-severity-MENEMONIC:description (hostname-n)"
      ],
      "rfc5424": {
        "format": "<pri>ver timestamp hostname appname procid msgid structured-data description",
        "note": "Optional fields (hostname, appname, procid, msgid, structured-data) can be specified with a hyphen (-)"
      }
    },
    "severity_levels": [
      {
        "name": "Emergency",
        "numeric": 0,
        "description": "System is unusable"
      },
      {
        "name": "Alert",
        "numeric": 1,
        "description": "Action must be taken immediately"
      },
      {
        "name": "Critical",
        "numeric": 2,
        "description": "Critical condition"
      },
      {
        "name": "Error",
        "numeric": 3,
        "description": "Error condition that does not fully impair system usability"
      },
      {
        "name": "Warning",
        "numeric": 4,
        "description": "Warning condition"
      },
      {
        "name": "Notice",
        "numeric": 5,
        "description": "Normal but significant condition"
      },
      {
        "name": "Informational",
        "numeric": 6,
        "description": "Informational messages (default priority for vsyslog)"
      },
      {
        "name": "Debug",
        "numeric": 7,
        "description": "Debug-level messages"
      }
    ],
    "syslog_message_acronyms": {
      "confd": "CLI configuration process",
      "FTM / FTMD": "Forwarding table manager",
      "FP": "Forwarding process",
      "RTM": "Route table manager",
      "TTM": "Tunnel table manager"
    },
