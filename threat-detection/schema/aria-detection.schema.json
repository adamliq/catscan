{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/adamliq/Threat-detection-library/schema/aria-detection.schema.json",
  "title": "Threat Detection Library - VMware Aria Operations for Logs Detection Entry",
  "description": "Schema for a single detection entry in data/aria-detections.json. A sibling of detection.schema.json, adapted for VMware Aria Operations for Logs search syntax (not Splunk SPL) and for detections that span the whole vSphere/vCenter/NSX stack rather than only ESXi.",
  "type": "object",
  "required": [
    "id", "vmw_id", "title", "description", "type", "status", "severity", "platform",
    "tool", "mitre_attack", "data_sources", "detection_logic", "aria_query",
    "how_to_implement", "known_false_positives", "references",
    "author", "created", "modified", "version"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Stable, kebab-case, URL-safe slug (prefixed with the lowercased vmw_id). Never reuse or rename once published." },
    "vmw_id": { "type": "string", "pattern": "^VMW-\\d+$", "description": "Original catalogue ID (VMW-001 .. VMW-150), preserved for cross-referencing the catalogue's groups/priority-set sections." },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "analytic_story": { "type": "array", "items": { "type": "string" } },
    "type": { "type": "string", "enum": ["TTP", "Anomaly", "Hunting", "Correlation"] },
    "status": { "type": "string", "enum": ["production", "experimental", "deprecated"] },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "platform": { "type": "string", "description": "VMware component this detection targets, e.g. 'vCenter / SSO', 'ESXi', 'Storage', 'Cluster'." },
    "product_version": { "type": "string" },
    "tool": { "type": "string", "description": "The SIEM/log platform this query is written for, e.g. 'VMware Aria Operations for Logs'." },
    "mitre_attack": {
      "type": "object",
      "required": ["tactics", "techniques"],
      "properties": {
        "tactics": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
        "techniques": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string" } } } }
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "detection_logic": { "type": "string", "description": "Tuning/threshold guidance - the source catalogue's 'Detection logic / tuning' note." },
    "aria_query": { "type": "string", "description": "VMware Aria Operations for Logs search expression (not Splunk SPL)." },
    "how_to_implement": { "type": "string" },
    "known_false_positives": { "type": "string" },
    "investigation_steps": { "type": "array", "items": { "type": "string" } },
    "risk_objects": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "type": { "type": "string" } } } },
    "references": {
      "type": "array",
      "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" } } }
    },
    "related_detections": { "type": "array", "items": { "type": "string" }, "description": "IDs of other entries in data/aria-detections.json." },
    "tags": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "created": { "type": "string", "format": "date" },
    "modified": { "type": "string", "format": "date" },
    "version": { "type": "string" }
  }
}
