{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/adamliq/Threat-detection-library/schema/vcf-detection.schema.json",
  "title": "Threat Detection Library - VMware Cloud Foundation Detection Entry",
  "description": "Schema for a single detection entry in data/vcf-detections.json (SDDC Manager, NSX, vSAN encryption, VCF Operations, VCF Operations for Logs, VCF Automation, VCF Salt, HCX, Tanzu/Kubernetes, and VCF-X cross-platform correlations). vCenter/ESXi/hypervisor-layer coverage already lives in schema/detection.schema.json (data/detections.json) and this catalogue does not duplicate it.",
  "type": "object",
  "required": [
    "id", "title", "description", "vcf_product", "component", "severity", "confidence",
    "detection_type", "mitre_attack", "required_log_source", "data_sources", "required_fields",
    "detection_logic", "spl", "tuning_guidance", "investigation_steps", "response_guidance",
    "telemetry_requirement", "detection_maturity", "false_positive_rating",
    "risk_scoring", "references", "author", "created", "modified", "version"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(VCF-X|VCF|NSX|VSAN|OPS|LOGS|AUTO|SALT|HCX|K8S)-[0-9]{3}$", "description": "Namespaced sequential ID." },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "vcf_product": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": [
        "SDDC Manager", "vCenter", "ESXi", "NSX Manager", "NSX Edge", "vSAN", "VCF Operations",
        "VCF Operations for Logs", "VCF Automation", "Salt Master", "Salt Minion", "HCX",
        "Content Library", "KMS", "Certificate Management", "Backup", "API", "Guest Operations",
        "Lifecycle Management", "Tanzu / Kubernetes", "Cross-platform"
      ] }
    },
    "component": { "type": "string" },
    "severity": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "detection_type": { "type": "string", "enum": ["Atomic", "Threshold", "Behavioral", "Anomaly", "Sequence", "Correlation", "Configuration change", "Authentication", "Administrative abuse", "Supply-chain", "Defense evasion", "Fleet-wide"] },
    "mitre_attack": {
      "type": "object",
      "required": ["tactics", "techniques"],
      "properties": {
        "tactics": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
        "techniques": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string" } } } }
      }
    },
    "attack_mapping_note": { "type": "string" },
    "required_log_source": { "type": "array", "items": { "type": "string" } },
    "data_sources": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "description": { "type": "string" } } }
    },
    "required_fields": { "type": "array", "items": { "type": "string" } },
    "detection_logic": { "type": "string" },
    "spl": { "type": "string" },
    "threshold": {
      "type": "object",
      "properties": {
        "count": { "type": ["string", "number"] },
        "distinct_count": { "type": ["string", "number"] },
        "time_window": { "type": "string" },
        "baseline_condition": { "type": "string" }
      }
    },
    "tuning_guidance": { "type": "string" },
    "investigation_steps": { "type": "array", "items": { "type": "string" } },
    "response_guidance": { "type": "string" },
    "telemetry_requirement": { "type": "string", "enum": ["Essential", "Recommended", "Optional"] },
    "cim_compatible": { "type": "boolean" },
    "cim_data_model": { "type": "string" },
    "detection_maturity": { "type": "string", "enum": ["Level 1 - simple indicator", "Level 2 - threshold", "Level 3 - behavioral", "Level 4 - correlation", "Level 5 - multi-platform attack sequence"] },
    "false_positive_rating": { "type": "string", "enum": ["Low", "Medium", "High"] },
    "risk_scoring": {
      "type": "object",
      "required": ["severity", "confidence", "impact", "score"],
      "properties": {
        "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
        "score": { "type": "integer", "minimum": 1, "maximum": 125 }
      }
    },
    "risk_object": { "type": "string" },
    "risk_object_type": { "type": "string", "enum": ["user", "system", "other"] },
    "references": { "type": "array", "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" } } } },
    "related_detections": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "created": { "type": "string", "format": "date" },
    "modified": { "type": "string", "format": "date" },
    "version": { "type": "string" }
  }
}
