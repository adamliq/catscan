{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/adamliq/Threat-detection-library/schema/ilo-detection.schema.json",
  "title": "Threat Detection Library - HPE iLO Detection Entry",
  "description": "Schema for a single detection entry in data/ilo-detections.json (HPE iLO, Redfish, Remote Console, Virtual Media, Firmware/UEFI, IML, AHS, HPE OneView, and HPE-X cross-platform/fleet correlations). Structurally aligned with schema/idrac-detection.schema.json and schema/fortinet-detection.schema.json.",
  "type": "object",
  "required": [
    "id", "title", "description", "platform", "component", "severity", "confidence",
    "detection_type", "mitre_attack", "required_log_source", "data_sources", "required_fields",
    "detection_logic", "spl", "tuning_guidance", "investigation_steps", "response_guidance",
    "telemetry_requirement", "detection_maturity", "false_positive_rating",
    "risk_scoring", "references", "author", "created", "modified", "version"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(ILO|HREDFISH|RC|VMEDIA|FW|IML|AHS|ONEVIEW|HPE-X)-[0-9]{3}$", "description": "Namespaced sequential ID. HREDFISH (not REDFISH) is used for the Redfish API namespace to avoid colliding with schema/idrac-detection.schema.json's own REDFISH-### namespace, since Redfish is a cross-vendor DMTF standard used by both iLO and iDRAC and detection IDs must be globally unique across the combined index.html library." },
    "title": { "type": "string" },
    "description": { "type": "string", "description": "What is detected, why it's suspicious, how it could be abused, and what legitimate activity might resemble it." },
    "platform": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": [
        "HPE iLO", "Redfish", "Remote Console", "Virtual Media", "Intelligent Provisioning",
        "UEFI / BIOS", "Firmware", "IML", "AHS", "HPE OneView", "HPE Compute Ops Management", "Cross-platform"
      ] }
    },
    "ilo_generation": { "type": "array", "items": { "type": "string", "enum": ["iLO 5", "iLO 6", "Both"] }, "description": "Present when telemetry/field availability differs between iLO 5 and iLO 6; omitted when generation-agnostic." },
    "component": { "type": "string", "description": "Specific component, e.g. Authentication, User management, Remote Console, Virtual Media, Firmware, BIOS / UEFI, Boot, Power, Network, Certificates, SNMP, Syslog, Redfish API, Security configuration, Hardware trust, Storage, OneView." },
    "severity": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "detection_type": { "type": "string", "enum": ["Atomic", "Threshold", "Behavioral", "Anomaly", "Sequence", "Correlation", "Configuration change", "Authentication", "Administrative abuse", "Firmware integrity", "Hardware trust", "Fleet-wide"] },
    "mitre_attack": {
      "type": "object",
      "required": ["tactics", "techniques"],
      "properties": {
        "tactics": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } } },
        "techniques": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string" } } } }
      }
    },
    "attack_mapping_note": { "type": "string", "description": "Present when ATT&CK does not cleanly represent out-of-band or firmware activity and the closest-fit technique is used with an explicit caveat." },
    "required_log_source": { "type": "array", "items": { "type": "string" }, "description": "e.g. iLO event/audit log, iLO security log, Integrated Management Log, syslog forwarding, Redfish audit/API events, HPE OneView audit, HPE Compute Ops Management audit, network telemetry, OS logs, hypervisor logs." },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": { "name": { "type": "string" }, "path": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "required_fields": { "type": "array", "items": { "type": "string" }, "description": "Fields the SPL depends on." },
    "detection_logic": { "type": "string", "description": "Why the SPL works." },
    "spl": { "type": "string" },
    "threshold": {
      "type": "object",
      "description": "Present only for Threshold/Behavioral/Correlation/Fleet-wide-type detections.",
      "properties": {
        "count": { "type": ["string", "number"] },
        "distinct_count": { "type": ["string", "number"] },
        "time_window": { "type": "string" },
        "baseline_condition": { "type": "string" }
      }
    },
    "tuning_guidance": { "type": "string" },
    "investigation_steps": { "type": "array", "items": { "type": "string" } },
    "response_guidance": { "type": "string" },
    "telemetry_requirement": { "type": "string", "enum": ["Essential", "Recommended", "Optional"] },
    "cim_compatible": { "type": "boolean" },
    "cim_data_model": { "type": "string", "description": "Splunk CIM data model this maps to, when cim_compatible is true, e.g. Authentication, Change, Network_Traffic, Endpoint, Intrusion_Detection, Data_Access." },
    "detection_maturity": { "type": "string", "enum": ["Level 1 - simple indicator", "Level 2 - threshold", "Level 3 - behavioral", "Level 4 - correlation", "Level 5 - multi-platform attack sequence"] },
    "false_positive_rating": { "type": "string", "enum": ["Low", "Medium", "High"] },
    "risk_scoring": {
      "type": "object",
      "required": ["severity", "confidence", "impact", "score"],
      "properties": {
        "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
        "score": { "type": "integer", "minimum": 1, "maximum": 125, "description": "severity * confidence * impact" }
      }
    },
    "risk_object": { "type": "string", "description": "Optional Splunk ES risk-based-alerting object field name, e.g. user, src_ip, iLO device, physical server, OneView appliance." },
    "risk_object_type": { "type": "string", "enum": ["user", "system", "other"] },
    "references": { "type": "array", "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" } } } },
    "related_detections": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "created": { "type": "string", "format": "date" },
    "modified": { "type": "string", "format": "date" },
    "version": { "type": "string" }
  }
}
